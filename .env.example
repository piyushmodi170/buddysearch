# Environment Variables Template for BuddySearch Production Deployment (MongoDB)

# MongoDB Database Configuration
# Local Docker MongoDB:
DATABASE_URL=mongodb://buddysearch:buddysearch_mongo_secret_123@mongo:27017/buddysearch?authSource=admin
# Or MongoDB Atlas Cloud:
# DATABASE_URL=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/buddysearch?retryWrites=true&w=majority

MONGO_INITDB_ROOT_USERNAME=buddysearch
MONGO_INITDB_ROOT_PASSWORD=buddysearch_mongo_secret_123
MONGO_INITDB_DATABASE=buddysearch

# Redis Configuration
REDIS_URL=redis://redis:6379

# Backend API Configuration
PORT=4000
NODE_ENV=production
JWT_SECRET=super_strong_jwt_secret_key_production_2026
JWT_REFRESH_SECRET=super_strong_jwt_refresh_secret_key_production_2026
FRONTEND_URL=http://localhost:3000
ADMIN_EMAILS=piyushmodi170@gmail.com
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# SMTP (also configurable from /admin)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Twilio SMS / OTP Service (Optional - defaults to console mode)
OTP_PROVIDER=console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AWS S3 Storage (Optional - defaults to local/mock)
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=buddysearch-production-media

# Frontend Configuration
# In Coolify the site and API share one URL. Leave these empty (same-origin).
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SOCKET_URL=

# Coolify (one Web Application):
# 1. Build pack = Dockerfile  (not Railpack)
# 2. Port = 3000
# 3. Base directory = empty
# 4. Branch = master
# Required env: DATABASE_URL (MongoDB Atlas replica set / mongodb+srv),
# JWT_SECRET, JWT_REFRESH_SECRET, FRONTEND_URL=https://your-domain
# Optional: REDIS_URL, GOOGLE_CLIENT_ID, RAZORPAY_*, SMTP_*
# Admin panel: sign in as piyushmodi170@gmail.com then open /admin
